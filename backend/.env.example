NODE_ENV=development
PORT=5000

# PostgreSQL connection string (Prisma format)
DATABASE_URL="postgresql://academy_app:academy_dev_pass@localhost:5432/academy_db?schema=public"

# Generate real random secrets for these before deploying anywhere real:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_dev_access_secret
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional — the app runs fine without Redis, it just loses caching/shared
# rate-limit state across multiple backend instances.
REDIS_URL=redis://localhost:6379

# Must match the frontend's origin exactly (used for CORS + cookie scoping)
FRONTEND_URL=http://localhost:5173

# Set to true once served over HTTPS in production
COOKIE_SECURE=false

# Only needed if you wire up S3 file uploads (profile photos, documents)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
