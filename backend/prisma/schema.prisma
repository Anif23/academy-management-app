// Academy Management System — Prisma schema
// Modular monolith: one schema, one PostgreSQL database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Auth / users
// --------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  COUNSELLOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ADMIN)
  department   String?
  phone        String?
  status       UserStatus @default(ACTIVE)
  avatar       String?
  // True for auto-created Student/Staff accounts until they change their
  // temporary (email-as-password) password for the first time.
  mustChangePassword Boolean @default(false)

  // Optional links to a domain profile, depending on role.
  employee     Employee?
  student      Student?

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// A refresh token is stored server-side (hashed) so it can be revoked on
// logout / password change, instead of trusting a long-lived client-only JWT.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// --------------------------------------------------------------------------
// Courses
// --------------------------------------------------------------------------

enum CourseStatus {
  ACTIVE
  INACTIVE
}

model Course {
  id          String       @id @default(cuid())
  name        String       @unique
  duration    String
  fee         Decimal      @db.Decimal(10, 2)
  description String?
  status      CourseStatus @default(ACTIVE)

  batches  Batch[]
  students Student[]
  walkIns  WalkIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courses")
}

// --------------------------------------------------------------------------
// Employees / trainers
// --------------------------------------------------------------------------

enum EmployeeType {
  TRAINER
  DEVELOPER
  DESIGNER
  VIDEO_EDITOR
  DIGITAL_MARKETING
  COUNSELLOR
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model Employee {
  id           String         @id @default(cuid())
  employeeCode String         @unique
  name         String
  type         EmployeeType
  email        String         @unique
  phone        String
  status       EmployeeStatus @default(ACTIVE)
  joiningDate  DateTime

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  trainerBatches   Batch[]      @relation("BatchTrainer")
  counselledLeads  WalkIn[]     @relation("WalkInCounsellor")
  counselledStuds  Student[]    @relation("StudentCounsellor")
  classReports     ClassReport[]
  createdTasks     Task[]           @relation("TaskCreator")
  reviewedSubmissions TaskSubmission[] @relation("SubmissionReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

// --------------------------------------------------------------------------
// Batches
// --------------------------------------------------------------------------

enum BatchStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

model Batch {
  id          String      @id @default(cuid())
  batchCode   String      @unique
  name        String
  startDate   DateTime
  endDate     DateTime
  classTiming String
  days        String[]
  status      BatchStatus @default(UPCOMING)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  trainerId String?
  trainer   Employee? @relation("BatchTrainer", fields: [trainerId], references: [id], onDelete: SetNull)

  students     Student[]
  attendance   Attendance[]
  classReports ClassReport[]
  tasks        Task[]
  checkIns     DailyCheckIn[]
  walkIns      WalkIn[] @relation("WalkInBatch")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("batches")
}

// --------------------------------------------------------------------------
// Students
// --------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  DROPPED
}

enum StudentMode {
  ONLINE
  OFFLINE
  HYBRID
}

model Student {
  id              String        @id @default(cuid())
  studentCode     String        @unique
  name            String
  photo           String?
  mobile          String
  email           String        @unique
  dob             DateTime?
  gender          Gender
  address         String
  qualification   String
  courseDuration  String
  joiningDate     DateTime
  mode            StudentMode   @default(OFFLINE)
  status          StudentStatus @default(ACTIVE)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  counsellorId String?
  counsellor   Employee? @relation("StudentCounsellor", fields: [counsellorId], references: [id], onDelete: SetNull)

  walkInId String? @unique
  walkIn   WalkIn? @relation(fields: [walkInId], references: [id], onDelete: SetNull)

  fee            Fee?
  attendance     Attendance[]
  taskSubmissions TaskSubmission[]
  performance    Performance[]
  checkIns       DailyCheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("students")
}

// --------------------------------------------------------------------------
// Walk-ins
// --------------------------------------------------------------------------

enum LeadSource {
  WALK_IN
  WEBSITE
  GOOGLE
  INSTAGRAM
  REFERRAL
}

enum LeadStatus {
  NEW
  CONTACTED
  COUNSELLING
  INTERESTED
  ADMISSION
  NOT_INTERESTED
}

model WalkIn {
  id            String     @id @default(cuid())
  name          String
  mobile        String
  email         String
  qualification String
  location      String
  source        LeadSource
  enquiryDate   DateTime
  remarks       String?
  followUpDate  DateTime?
  status        LeadStatus @default(NEW)

  courseInterestedId String
  courseInterested   Course @relation(fields: [courseInterestedId], references: [id], onDelete: Restrict)

  // The batch chosen during public registration (Register.tsx step 3), if
  // any — carried through to admission so staff don't have to ask again.
  batchId String?
  batch   Batch?  @relation("WalkInBatch", fields: [batchId], references: [id], onDelete: SetNull)

  counsellorId String?
  counsellor   Employee? @relation("WalkInCounsellor", fields: [counsellorId], references: [id], onDelete: SetNull)

  convertedStudent Student?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("walk_ins")
}

// --------------------------------------------------------------------------
// Fees & payments
// --------------------------------------------------------------------------

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
}

model Fee {
  id              String   @id @default(cuid())
  courseFee       Decimal  @db.Decimal(10, 2)
  discount        Decimal  @default(0) @db.Decimal(10, 2)
  nextPaymentDate DateTime?
  remarks         String?

  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fees")
}

model Payment {
  id      String      @id @default(cuid())
  amount  Decimal     @db.Decimal(10, 2)
  date    DateTime
  mode    PaymentMode
  remarks String?

  feeId String
  fee   Fee    @relation(fields: [feeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([feeId])
  @@map("payments")
}

// --------------------------------------------------------------------------
// Attendance
// --------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

model Attendance {
  id     String           @id @default(cuid())
  date   DateTime
  status AttendanceStatus

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // A student can only have one attendance record per batch per day.
  @@unique([studentId, batchId, date])
  @@index([batchId, date])
  @@map("attendance")
}

// --------------------------------------------------------------------------
// Class / training reports
// --------------------------------------------------------------------------

enum ClassReportTaskStatus {
  NOT_GIVEN
  GIVEN
  REVIEWED
}

model ClassReport {
  id                 String                 @id @default(cuid())
  date               DateTime
  topic              String
  module             String
  description        String
  tasksGiven         String?
  taskStatus         ClassReportTaskStatus  @default(GIVEN)
  studentPerformance String?
  remarks            String?
  nextClassPlan      String?

  batchId String
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  trainerId String?
  trainer   Employee? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId, date])
  @@map("class_reports")
}

// --------------------------------------------------------------------------
// Tasks — one Task per assignment (individual OR batch), with an
// independent TaskSubmission row per assigned student so progress is
// tracked per-student without duplicating the task itself.
// --------------------------------------------------------------------------

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// Lifecycle: PENDING -> SUBMITTED -> REVIEWED
//        or: SUBMITTED -> NEEDS_REVISION -> RESUBMITTED -> REVIEWED
// OVERDUE is never stored — it's derived (PENDING/NEEDS_REVISION + dueDate
// passed) at read time in taskService, since it depends on "now".
enum SubmissionStatus {
  PENDING
  SUBMITTED
  NEEDS_REVISION
  RESUBMITTED
  REVIEWED
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String
  assignedDate DateTime
  dueDate      DateTime
  priority     TaskPriority @default(MEDIUM)

  // Exactly one of these is set (enforced in taskService, not the DB):
  // a batch task fans out to a TaskSubmission per active student in the
  // batch; an individual task gets a single TaskSubmission.
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   Employee? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  attachments TaskAttachment[]
  submissions TaskSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([createdById])
  @@map("tasks")
}

// Reference files the trainer attaches to the task itself (not a student
// submission) — e.g. an assignment brief or starter files.
model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url        String
  fileName   String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

// The actual unit of per-student progress. Created up front (status
// PENDING) for every student a task is assigned to, so "who has NOT
// submitted" is a plain query rather than an absence to infer.
model TaskSubmission {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status SubmissionStatus @default(PENDING)

  // Rich-text (HTML from the editor) comment/answer the student submits.
  content String?

  submittedAt DateTime?

  trainerFeedback String?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      Employee? @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  files SubmissionFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A student has exactly one submission record per task.
  @@unique([taskId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("task_submissions")
}

model SubmissionFile {
  id           String         @id @default(cuid())
  submissionId String
  submission   TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  url          String
  fileName     String
  fileType     String
  fileSize     Int
  uploadedAt   DateTime       @default(now())

  @@index([submissionId])
  @@map("submission_files")
}

// --------------------------------------------------------------------------
// Performance
// --------------------------------------------------------------------------

model Performance {
  id                 String   @id @default(cuid())
  date               DateTime
  technicalKnowledge Int
  practicalSkills    Int
  communication      Int
  attendance         Int
  taskCompletion     Int
  behaviour          Int
  remarks            String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("performance")
}

// --------------------------------------------------------------------------
// Academy Settings & Content
// --------------------------------------------------------------------------

model AcademySettings {
  id          String  @id @default("singleton") // Only one row allowed
  name        String
  logoUrl     String?
  email       String
  phone       String
  whatsapp    String
  address     String
  city        String
  state       String
  country     String
  description String?
  mission     String?
  vision      String?
  workingHours String?
  // Optional — the admin's CRM-style page for managing these; a blank
  // string means "not set" and the public site simply omits that icon.
  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  youtubeUrl   String?
  twitterUrl   String?
  // Legal / compliance details shown in the footer and referenced by the
  // Privacy Policy — required so the site names a real entity and a real
  // contact for data-protection grievances (Indian DPDP Act, 2023).
  legalName             String?
  registrationNumber    String? // CIN / GST / other business registration number
  grievanceOfficerName  String?
  grievanceOfficerEmail String?
  grievanceOfficerPhone String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("academy_settings")
}

model Testimonial {
  id        String   @id @default(cuid())
  studentName String
  role       String? // e.g., "Software Engineer at Google"
  content    String
  photo     String?
  rating    Int      @default(5)
  isActive   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  /// Optional link — e.g. to a course or the registration page. Opens in the same tab.
  link      String?
  /// Small label shown before the message, e.g. "New" or "Offer".
  tag       String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  /// Optional window. Null start/end means "always" (bounded only by isActive).
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("faqs")
}

// --------------------------------------------------------------------------
// Daily student check-in ("How was your day?") — optional, non-blocking.
// --------------------------------------------------------------------------

model DailyCheckIn {
  id   String   @id @default(cuid())
  // Always stored truncated to midnight (UTC) by the service layer so the
  // unique constraint below actually enforces "one check-in per day".
  date DateTime

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  mood            String? // free-form: "How was your day?"
  classFeedback   String? // "How was today's class?"
  understood      Boolean?
  needsHelp       Boolean @default(false)
  helpDescription String?

  createdAt DateTime @default(now())

  // At most one check-in per student per calendar day.
  @@unique([studentId, date])
  @@index([batchId])
  @@map("daily_check_ins")
}

// --------------------------------------------------------------------------
// Internal admin-app branding (sidebar/login logo, app name, tagline) —
// stored server-side (not localStorage) so it's the same for every admin,
// on every device/browser, not just whoever last changed it locally.
// --------------------------------------------------------------------------

model AppBranding {
  id          String   @id @default("singleton")
  appName     String   @default("Academy Management")
  tagline     String   @default("For Managing Everything")
  logoUrl     String?
  updatedAt   DateTime @updatedAt

  @@map("app_branding")
}

// --------------------------------------------------------------------------
// Dynamic role permissions — lets an admin toggle what each role can do
// from a settings page instead of requiring a code change + redeploy.
// Bootstrapped once from constants/roles.js's static PERMISSIONS map (see
// permissionsService.js); that static file becomes the fallback/reference
// list of every known permission key, not the live source of truth anymore.
// --------------------------------------------------------------------------

model RolePermission {
  id         String @id @default(cuid())
  role       Role
  permission String

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}
